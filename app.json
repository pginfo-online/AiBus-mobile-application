{
  "expo": {
    "name": "AiBus",
    "slug": "aibus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibus",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#013C9A",
    "description": "AiBus - Smart local bus ticket booking network across India.",
    "ios": {
      "bundleIdentifier": "com.worknai.aibus",
      "buildNumber": "1",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.worknai.aibus",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#051634",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPhonePe.ts",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#051634",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f3fe511-37f1-4289-b155-38ddda01238f"
      }
    },
    "owner": "pginfoonline"
  }
}
